# Milvus
MILVUS_URI=https://your-cluster.zillizcloud.com
MILVUS_TOKEN=your-token

# 向量化（阿里百炼）
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 迁移说明：库当前为 text-embedding-v2 建（1536 维），本服务暂用 v2 对齐；
# 待 doc-kit 用 v4 重建库（1024 维）后，这里改回 text-embedding-v4。
# 必须与 doc-kit 入库模型一致，否则检索报 vector dimension mismatch
EMBEDDING_MODEL=text-embedding-v2

# LLM（DeepSeek）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Redis（语义缓存）
REDIS_URL=redis://localhost:6379/0
# 语义缓存开关：true=开启（默认）/ false=禁用（不再连接 Redis 做缓存读写）
SEMANTIC_CACHE_ENABLED=true

# Langfuse（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Collection
COLLECTION_NAME=chartermate_docs
SUMMARY_COLLECTION_NAME=chartermate_summaries
