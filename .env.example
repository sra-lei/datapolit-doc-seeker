# Milvus
MILVUS_URI=https://your-cluster.zillizcloud.com
MILVUS_TOKEN=your-token

# 运行环境：development（默认，开放 /docs）/ production（关闭 /docs、/redoc、/openapi.json）
ENVIRONMENT=development

# 向量化（阿里百炼）
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 与 doc-kit 入库模型一致（text-embedding-v4 = 1024 维，库已用 v4 重建）
EMBEDDING_MODEL=text-embedding-v4

# LLM（DeepSeek）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ⚠️ 若此处填推理模型（如 deepseek-v4-flash / deepseek-reasoner），必须同时放开下面
# 三处输出预算：推理模型的 reasoning token 与正文共用预算，预算不足会出现
# finish_reason=length 且正文为空（表现为「答案为空」「查询分解静默失效」）。
LLM_MODEL=deepseek-chat
# 答案生成输出预算（token）
LLM_GENERATE_MAX_TOKENS=8000
# 查询改写输出预算（token）
LLM_DECOMPOSE_MAX_TOKENS=2000
# 截断且正文为空时的放大预算重试（每处至多一次；<= 当前预算即视为关闭）
LLM_RETRY_MAX_TOKENS=16000
# 单次 LLM 调用的 HTTP 超时（秒）：推理模型响应 10~60s，切勿沿用普通模型的 15s
LLM_TIMEOUT_SECONDS=120
# 采样温度：默认 0.3（历史口径）。评估 / A-B 对比**必须置 0**，否则同代码同语料
# 的单题分数摆幅（实测 0.75）会盖过待测改动的量级。
LLM_TEMPERATURE=0.3
# 查询改写的采样温度（默认 0.1；评估时同样建议置 0）
LLM_DECOMPOSE_TEMPERATURE=0.1

# 语义缓存开关：true=开启（默认）/ false=禁用（不再连接 Redis 做缓存读写）
# 注意：REDIS_URL 不在此配置——docker compose（本地/生产）均已固定为服务名
# redis://redis:6379/0；宿主机直跑 uvicorn 时用 core/config.py 默认值 localhost:6379/0
SEMANTIC_CACHE_ENABLED=true

# Langfuse（可选；未配置时链路追踪自动降级为 no-op，不影响业务）
# API Keys 在 Langfuse 项目 Settings -> API Keys 创建（公钥/私钥一对）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端区域：https://cloud.langfuse.com（欧盟）/ https://us.cloud.langfuse.com（美国）
# 自建：http://<your-host>:3000；SDK 优先读 LANGFUSE_BASE_URL，其次 LANGFUSE_HOST
LANGFUSE_BASE_URL=
LANGFUSE_HOST=

# Collection
COLLECTION_NAME=chartermate_docs
SUMMARY_COLLECTION_NAME=chartermate_summaries

# 热门问题 Top10（P4，可选）
# 记录 chat 问题并预热语义缓存，供 ChatWidget 欢迎语使用；默认开启
TOP_WARMUP_ENABLED=true
TOP_WARMUP_INTERVAL_HOURS=6
TOP_WARMUP_SIZE=10
