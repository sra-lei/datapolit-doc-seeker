# Milvus
MILVUS_URI=https://your-cluster.zillizcloud.com
MILVUS_TOKEN=your-token

# 向量化（阿里百炼）
DASHSCOPE_API_KEY=your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 必须与 doc-kit 入库时使用的模型一致：库中向量为 1536 维（text-embedding-v2 默认输出），
# 若用 v4（默认 1024 维）检索会报 vector dimension mismatch（6144 vs 4096 bytes）
EMBEDDING_MODEL=text-embedding-v2

# LLM（DeepSeek）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Redis（语义缓存）
REDIS_URL=redis://localhost:6379/0
# 语义缓存开关：true=开启（默认）/ false=禁用（不再连接 Redis 做缓存读写）
SEMANTIC_CACHE_ENABLED=true

# Langfuse（可选）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Collection
COLLECTION_NAME=chartermate_docs
SUMMARY_COLLECTION_NAME=chartermate_summaries
